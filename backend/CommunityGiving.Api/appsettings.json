{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Port=5432;Database=communitygiving;Username=communitygiving_app;Password=CHANGE_ME_USE_ENV_VAR"
  },

  "Jwt": {
    "Issuer": "CommunityGivingApi",
    "Audience": "CommunityGivingClient",
    "Key": "CHANGE_ME_use_a_random_64_char_secret_set_via_env_var_JWT__Key",
    "ExpiryHours": "8"
  },

  "Stripe": {
    "SecretKey": "sk_test_CHANGE_ME_set_via_env_var_Stripe__SecretKey",
    "PublishableKey": "pk_test_CHANGE_ME_this_one_is_safe_to_expose_to_frontend",
    "WebhookSecret": "whsec_CHANGE_ME_set_via_env_var_Stripe__WebhookSecret"
  },

  "Email": {
    "SmtpHost": "",
    "SmtpPort": "587",
    "SmtpUsername": "",
    "SmtpPassword": "CHANGE_ME_use_env_var_Email__SmtpPassword",
    "FromAddress": "noreply@yourorg.org",
    "FromName": "Our Community"
  },

  "Sms": {
    "TwilioAccountSid": "",
    "TwilioAuthToken": "CHANGE_ME_use_env_var_Sms__TwilioAuthToken",
    "TwilioFromNumber": ""
  },

  "AllowedOrigins": [
    "https://yourorg.org",
    "http://localhost:5173"
  ],

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "POST:/api/auth/login", "Period": "5m", "Limit": 10 },
      { "Endpoint": "POST:/api/auth/register", "Period": "1h", "Limit": 10 },
      { "Endpoint": "POST:/api/auth/forgot-password", "Period": "15m", "Limit": 5 },
      { "Endpoint": "POST:/api/auth/refresh", "Period": "1m", "Limit": 20 },
      { "Endpoint": "POST:/api/payments/create-intent", "Period": "1m", "Limit": 20 },
      { "Endpoint": "POST:/api/notifications/send", "Period": "1m", "Limit": 5 },
      { "Endpoint": "POST:/api/invoices/*", "Period": "1m", "Limit": 15 },
      { "Endpoint": "*", "Period": "1m", "Limit": 120 }
    ]
  }
}
